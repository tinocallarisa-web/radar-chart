{
  "dataRoles": [
    {
      "name": "axis",
      "kind": "Grouping",
      "displayName": "Axis",
      "displayNameKey": "Role_axis",
      "description": "One spoke per value: skill, criterion, KPI. A hierarchy gives drilldown. Without it, each measure in Values is an axis.",
      "descriptionKey": "Role_axis_Desc"
    },
    {
      "name": "values",
      "kind": "Measure",
      "displayName": "Values",
      "displayNameKey": "Role_values",
      "description": "The score on each axis. With Axis and no Series, each measure is a series.",
      "descriptionKey": "Role_values_Desc"
    },
    {
      "name": "series",
      "kind": "Grouping",
      "displayName": "Series (legend)",
      "displayNameKey": "Role_series",
      "description": "One shape per value: supplier, employee, product. Free shows 3; Pro up to 12.",
      "descriptionKey": "Role_series_Desc"
    },
    {
      "name": "target",
      "kind": "Measure",
      "displayName": "Target (Pro)",
      "displayNameKey": "Role_target",
      "description": "Required level per axis: a dashed shape and the gap on every axis.",
      "descriptionKey": "Role_target_Desc"
    },
    {
      "name": "scaleMin",
      "kind": "Measure",
      "displayName": "Scale minimum (Pro)",
      "displayNameKey": "Role_scaleMin",
      "description": "Bottom of the scale per axis, for a scale per axis.",
      "descriptionKey": "Role_scaleMin_Desc"
    },
    {
      "name": "scaleMax",
      "kind": "Measure",
      "displayName": "Scale maximum (Pro)",
      "displayNameKey": "Role_scaleMax",
      "description": "Top of the scale per axis, such as the maximum points of each question.",
      "descriptionKey": "Role_scaleMax_Desc"
    },
    {
      "name": "axisGroup",
      "kind": "Grouping",
      "displayName": "Axis group (Pro)",
      "displayNameKey": "Role_axisGroup",
      "description": "Groups of axes drawn as named arcs: technical, personal.",
      "descriptionKey": "Role_axisGroup_Desc"
    },
    {
      "name": "note",
      "kind": "Measure",
      "displayName": "Note (Pro)",
      "displayNameKey": "Role_note",
      "description": "A text measure shown next to the point as an annotation.",
      "descriptionKey": "Role_note_Desc"
    },
    {
      "name": "panel",
      "kind": "Grouping",
      "displayName": "Small multiples (Pro)",
      "displayNameKey": "Role_panel",
      "description": "One radar per value, on a shared scale.",
      "descriptionKey": "Role_panel_Desc"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "displayNameKey": "Role_tooltips",
      "description": "Extra values in the tooltip.",
      "descriptionKey": "Role_tooltips_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "values": {
            "max": 40
          },
          "series": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "scaleMin": {
            "max": 1
          },
          "scaleMax": {
            "max": 1
          },
          "axisGroup": {
            "max": 1
          },
          "note": {
            "max": 1
          },
          "panel": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "axis"
              }
            },
            {
              "bind": {
                "to": "axisGroup"
              }
            },
            {
              "bind": {
                "to": "panel"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "bind": {
                  "to": "values"
                }
              },
              {
                "bind": {
                  "to": "target"
                }
              },
              {
                "bind": {
                  "to": "scaleMin"
                }
              },
              {
                "bind": {
                  "to": "scaleMax"
                }
              },
              {
                "bind": {
                  "to": "note"
                }
              },
              {
                "bind": {
                  "to": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 60
              }
            }
          }
        }
      }
    }
  ],
